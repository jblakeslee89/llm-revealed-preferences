\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Data inventory and model-free quantities. Each run scores the same 1{,}680-cell grid. A/B mass is the median unnormalized probability on the answer tokens. Dominance is mean probability on the strictly larger sure amount over 80 controls. The frame gap is mixed minus gain uptake on terminal-wealth-identical lotteries.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:inventory}{{1}{7}{Data inventory and model-free quantities. Each run scores the same 1{,}680-cell grid. A/B mass is the median unnormalized probability on the answer tokens. Dominance is mean probability on the strictly larger sure amount over 80 controls. The frame gap is mixed minus gain uptake on terminal-wealth-identical lotteries}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.2}Base models barely track value}{7}{subsection.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}The staircase: attribution to supervised fine-tuning}{8}{subsection.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces OLMo-2 training staircase, all elicited under the identical few-shot format ($n = 1{,}680$ cells per stage; structural fit on the 1{,}600 core cells under $\phi = 1$). Brackets are 95\% profile-likelihood intervals from the wide-bounds refit. $^{\dagger }$ = estimate at the edge of the wide box, where $\lambda $ reaches zero and $\alpha $ reaches one; the base model's intervals use the unclustered dispersion scaling.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:stairs}{{2}{8}{OLMo-2 training staircase, all elicited under the identical few-shot format ($n = 1{,}680$ cells per stage; structural fit on the 1{,}600 core cells under $\phi = 1$). Brackets are 95\% profile-likelihood intervals from the wide-bounds refit. $^{\dagger }$ = estimate at the edge of the wide box, where $\lambda $ reaches zero and $\alpha $ reaches one; the base model's intervals use the unclustered dispersion scaling}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Panel A: the OLMo-2 staircase. Dominance compliance and the frame gap both make their largest move at supervised fine-tuning, and the base model sits near chance on dominance. Panel B: the framing response across families, with the Phase 2 Haiku estimate for comparison. The sign and the magnitude are both family-specific.}}{8}{figure.1}\protected@file@percent }
\newlabel{fig:stairs}{{1}{8}{Panel A: the OLMo-2 staircase. Dominance compliance and the frame gap both make their largest move at supervised fine-tuning, and the base model sits near chance on dominance. Panel B: the framing response across families, with the Phase 2 Haiku estimate for comparison. The sign and the magnitude are both family-specific}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scaled profile deviance for $\alpha $, $\lambda $ and $\gamma $ across the wide-bounds refit. The horizontal line is the 95\% cutoff; a curve that stays under it to the edge of the axis marks a parameter the data do not bound in that direction. Solid curves use the gamble-clustered scaling, dashed curves the dispersion fallback for fits at the edge of the box. Top row: after SFT the three OLMo stages lie on top of one another, while the base model sits apart.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:profiles}{{2}{10}{Scaled profile deviance for $\alpha $, $\lambda $ and $\gamma $ across the wide-bounds refit. The horizontal line is the 95\% cutoff; a curve that stays under it to the edge of the axis marks a parameter the data do not bound in that direction. Solid curves use the gamble-clustered scaling, dashed curves the dispersion fallback for fits at the edge of the box. Top row: after SFT the three OLMo stages lie on top of one another, while the base model sits apart}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Format instability, with a model-specific direction}{10}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Dominance compliance by elicitation format for the three instruct models. Which format elicits an engaged subject reverses between Qwen and OLMo, and Llama's dominance compliance is stable across both. The same weights score 0.680 or 0.927 depending only on how the prompt is packaged, so format is part of the measurement rather than a neutral container for it.}}{11}{figure.3}\protected@file@percent }
\newlabel{fig:format}{{3}{11}{Dominance compliance by elicitation format for the three instruct models. Which format elicits an engaged subject reverses between Qwen and OLMo, and Llama's dominance compliance is stable across both. The same weights score 0.680 or 0.927 depending only on how the prompt is packaged, so format is part of the measurement rather than a neutral container for it}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Framing heterogeneity across families}{11}{subsection.5.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Induced valuation: the models cannot execute an induced rule}{12}{subsection.5.6}\protected@file@percent }
\newlabel{sec:induced}{{5.6}{12}{Induced valuation: the models cannot execute an induced rule}{subsection.5.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Induced-valuation compliance under a risk-neutral expected-value instruction. Compliance is the mean probability mass on the induced-optimal option, restricted to cells where the induced rule clearly separates the options ($|\ln \mathrm  {EU}$ ratio$| \ge 0.05$; 1{,}221 to 1{,}240 cells per run). Baseline is the uninduced run from the same model and format, scored against the same rule.}}{12}{table.3}\protected@file@percent }
\newlabel{tab:induced}{{3}{12}{Induced-valuation compliance under a risk-neutral expected-value instruction. Compliance is the mean probability mass on the induced-optimal option, restricted to cells where the induced rule clearly separates the options ($|\ln \mathrm {EU}$ ratio$| \ge 0.05$; 1{,}221 to 1{,}240 cells per run). Baseline is the uninduced run from the same model and format, scored against the same rule}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Compliance with an instructed decision rule, by what the rule demands. The bars are expected-value compliance on cells where following the rule requires multiplying $p$ by $h$: uninduced against induced, both hugging chance at every training stage. The line is accuracy on the dominant controls under the same instruction, where the induced optimum requires no arithmetic, reaching 1.000 by DPO. Post-training buys instruction-following on the cells that need no computation and does not buy the computation.}}{13}{figure.4}\protected@file@percent }
\newlabel{fig:induced}{{4}{13}{Compliance with an instructed decision rule, by what the rule demands. The bars are expected-value compliance on cells where following the rule requires multiplying $p$ by $h$: uninduced against induced, both hugging chance at every training stage. The line is accuracy on the dominant controls under the same instruction, where the induced optimum requires no arithmetic, reaching 1.000 by DPO. Post-training buys instruction-following on the cells that need no computation and does not buy the computation}{figure.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Reasoning first: the ceiling was the format}{13}{subsection.5.7}\protected@file@percent }
\newlabel{sec:reason}{{5.7}{13}{Reasoning first: the ceiling was the format}{subsection.5.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces The reason-then-answer arm against the immediate-answer runs on the same 840 cells. EV is the share of the 620 clear core cells on which the model puts more than half its probability on the expected-value-optimal option (hard accuracy, so the immediate-answer figures differ slightly from the compliance mass in Table~\ref {tab:induced}). Gap is mean $P(\text  {gamble})$ in the mixed frame minus the gain frame. Qwen answers in chat format, the OLMo checkpoints in few-shot.}}{13}{table.4}\protected@file@percent }
\newlabel{tab:reason}{{4}{13}{The reason-then-answer arm against the immediate-answer runs on the same 840 cells. EV is the share of the 620 clear core cells on which the model puts more than half its probability on the expected-value-optimal option (hard accuracy, so the immediate-answer figures differ slightly from the compliance mass in Table~\ref {tab:induced}). Gap is mean $P(\text {gamble})$ in the mixed frame minus the gain frame. Qwen answers in chat format, the OLMo checkpoints in few-shot}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Panel A: agreement with expected value on clear cells, by elicitation regime and instruction. Reasoning moves every subject well above chance, and the instruction adds to it. Panel B: the frame gap without instruction. Reasoning reverses Qwen's response to loss wording and removes OLMo Instruct's. OLMo SFT keeps a large gap, which is gone by the DPO checkpoint.}}{14}{figure.5}\protected@file@percent }
\newlabel{fig:reason}{{5}{14}{Panel A: agreement with expected value on clear cells, by elicitation regime and instruction. Reasoning moves every subject well above chance, and the instruction adds to it. Panel B: the frame gap without instruction. Reasoning reverses Qwen's response to loss wording and removes OLMo Instruct's. OLMo SFT keeps a large gap, which is gone by the DPO checkpoint}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces The clarification check, Qwen Instruct (chat), reasoning first, gain and mixed frames of the 20 matched gambles (400 cells). Mixed EV is agreement with expected value on clear mixed-frame cells; the next column restricts to cells where the gamble is the better option.}}{15}{table.5}\protected@file@percent }
\newlabel{tab:clarify}{{5}{15}{The clarification check, Qwen Instruct (chat), reasoning first, gain and mixed frames of the 20 matched gambles (400 cells). Mixed EV is agreement with expected value on clear mixed-frame cells; the next column restricts to cells where the gamble is the better option}{table.5}{}}
