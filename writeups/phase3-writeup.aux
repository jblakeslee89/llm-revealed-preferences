\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Data inventory and model-free quantities. Each run scores the same 1{,}680-cell grid. A/B mass is the median unnormalized probability on the answer tokens. Dominance is mean probability on the strictly larger sure amount over 80 controls. The frame gap is mixed minus gain uptake on terminal-wealth-identical lotteries.}}{6}{table.1}\protected@file@percent }
\newlabel{tab:inventory}{{1}{6}{Data inventory and model-free quantities. Each run scores the same 1{,}680-cell grid. A/B mass is the median unnormalized probability on the answer tokens. Dominance is mean probability on the strictly larger sure amount over 80 controls. The frame gap is mixed minus gain uptake on terminal-wealth-identical lotteries}{table.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.3}The staircase: attribution to supervised fine-tuning}{6}{subsection.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces OLMo-2 training staircase, all elicited under the identical few-shot format ($n = 1{,}680$ cells per stage; structural fit on the 1{,}600 core cells under $\phi = 1$). $^{*}$ = parameter at its bound, where the value and its bootstrap interval are not trustworthy.}}{6}{table.2}\protected@file@percent }
\newlabel{tab:stairs}{{2}{6}{OLMo-2 training staircase, all elicited under the identical few-shot format ($n = 1{,}680$ cells per stage; structural fit on the 1{,}600 core cells under $\phi = 1$). $^{*}$ = parameter at its bound, where the value and its bootstrap interval are not trustworthy}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Panel A: the OLMo-2 staircase. Dominance compliance and the frame gap both make their largest move at supervised fine-tuning, and the base model sits near chance on dominance. Panel B: the framing response across families, with the Phase 2 Haiku estimate for comparison. The sign and the magnitude are both family-specific.}}{7}{figure.1}\protected@file@percent }
\newlabel{fig:stairs}{{1}{7}{Panel A: the OLMo-2 staircase. Dominance compliance and the frame gap both make their largest move at supervised fine-tuning, and the base model sits near chance on dominance. Panel B: the framing response across families, with the Phase 2 Haiku estimate for comparison. The sign and the magnitude are both family-specific}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.4}Format instability, with a model-specific direction}{7}{subsection.5.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Dominance compliance by elicitation format for the three instruct models. Which format elicits an engaged subject reverses between Qwen and OLMo, and Llama is stable across both. The same weights score 0.680 or 0.927 depending only on how the prompt is packaged, so format is part of the measurement rather than a neutral container for it.}}{8}{figure.2}\protected@file@percent }
\newlabel{fig:format}{{2}{8}{Dominance compliance by elicitation format for the three instruct models. Which format elicits an engaged subject reverses between Qwen and OLMo, and Llama is stable across both. The same weights score 0.680 or 0.927 depending only on how the prompt is packaged, so format is part of the measurement rather than a neutral container for it}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5}Framing heterogeneity across families}{8}{subsection.5.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.6}Induced valuation: the models cannot execute an induced rule}{9}{subsection.5.6}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Induced-valuation compliance under a risk-neutral expected-value instruction. Compliance is the mean probability mass on the induced-optimal option, restricted to cells where the induced rule clearly separates the options ($|\ln \mathrm  {EU}$ ratio$| \ge 0.05$; 1{,}221 to 1{,}240 cells per run). Baseline is the uninduced run from the same model and format, scored against the same rule.}}{9}{table.3}\protected@file@percent }
\newlabel{tab:induced}{{3}{9}{Induced-valuation compliance under a risk-neutral expected-value instruction. Compliance is the mean probability mass on the induced-optimal option, restricted to cells where the induced rule clearly separates the options ($|\ln \mathrm {EU}$ ratio$| \ge 0.05$; 1{,}221 to 1{,}240 cells per run). Baseline is the uninduced run from the same model and format, scored against the same rule}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Compliance with an instructed decision rule, by what the rule demands. The bars are expected-value compliance on cells where following the rule requires multiplying $p$ by $h$: uninduced against induced, both hugging chance at every training stage. The line is accuracy on the dominant controls under the same instruction, where the induced optimum requires no arithmetic, reaching 1.000 by DPO. Post-training buys instruction-following on the cells that need no computation and does not buy the computation.}}{9}{figure.3}\protected@file@percent }
\newlabel{fig:induced}{{3}{9}{Compliance with an instructed decision rule, by what the rule demands. The bars are expected-value compliance on cells where following the rule requires multiplying $p$ by $h$: uninduced against induced, both hugging chance at every training stage. The line is accuracy on the dominant controls under the same instruction, where the induced optimum requires no arithmetic, reaching 1.000 by DPO. Post-training buys instruction-following on the cells that need no computation and does not buy the computation}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.7}Held-out validation}{10}{subsection.5.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Held-out mean per-cell deviance on gambles the fit never saw, averaged over 10 random 30/10 splits. The structural model beats the probability-only reduced form in every family and on every individual split, and the constant benchmark trails both. Phase 1's in-sample near-tie between the structural model and the probability-only logit does not survive out of sample.}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:holdout}{{4}{10}{Held-out mean per-cell deviance on gambles the fit never saw, averaged over 10 random 30/10 splits. The structural model beats the probability-only reduced form in every family and on every individual split, and the constant benchmark trails both. Phase 1's in-sample near-tie between the structural model and the probability-only logit does not survive out of sample}{figure.4}{}}
